#固定内容
def hello_world():
    print("miaomiaomiao")
hello_world()
#赋值
def hello_world(name):
    print("miaomiaomiao",name)
hello_world("python")
#双变量
def introduce(name,age):
    print("hello","我是",name,"今年",age,"岁")
introduce("小李",19)
#新赋值会覆盖就赋值
def introduce(name,age=18):
    print("hello","我是",name,"今年",age,"岁")
introduce("小李",19)
