#比大小
def check_guess(guess,answer=7):
    if guess < answer:
        return "大了"
    if guess > answer:
        return "小了"
    return "猜对了"
print(check_guess(9))
#for循环
def check_guess(guess,answer=7):
    if guess < answer:
        return "大了"
    if guess > answer:
        return "小了"
    return "猜对了"
guess = [5,9,7]
for guess in guess:
    print(check_guess(guess))