menu = {
    '鱼香肉丝':15,
    '宫保鸡丁':20,
    '红烧肉':30,
    '水煮鱼':40
}
for i in menu:
    print(i,menu[i])

money = int(input('请输入您的余额'))

choose = input('请输入你想要的菜品')
if choose in menu:
    price = menu[choose]
    print(f"\n您点了：{choose}, 单价{price} 元")
    if money >= price:
        print(f"支付成功，剩余余额：{money - price} 元")
    else:
        print(f"余额不足，还差 {price - money}元")
else:
    print("菜单中没有这道菜，请核对菜品名称")            